nceTd">
<p local-id=3D"34e7029d8de2">Information may be inconsistent</p></td>
<td data-local-id=3D"7d433e47-d753-474c-b846-83c63f7550fd" class=3D"conflue=
nceTd">
<p local-id=3D"668a2c7456cf">Staff and volunteers experience additional wor=
k</p></td>
<td data-local-id=3D"1c25008c-3250-430a-ad3c-5618c0616452" class=3D"conflue=
nceTd">
<p local-id=3D"ea2411b0b71a">Information is harder to control</p></td>
<td data-local-id=3D"b3dab2f0-ad6d-4b5d-ba90-b792300c1798" class=3D"conflue=
nceTd">
<p local-id=3D"678cbc29986b">High</p></td>
</tr>
<tr data-local-id=3D"3b8a2682-566d-429e-bbeb-90f62a9ef4a3">
<td data-local-id=3D"8cd7fdef-a0c2-4c26-958e-0c163baa7402" class=3D"conflue=
nceTd">
<p local-id=3D"bb711df4d761">Duplicate manual data entry</p></td>
<td data-local-id=3D"62c71512-e895-4ce0-8df7-e9434a5ac48f" class=3D"conflue=
nceTd">
<p local-id=3D"e09b24b76ae2">Processes require repeated effort</p></td>
<td data-local-id=3D"894abc16-f20c-4505-b6d3-9f55c399b156" class=3D"conflue=
nceTd">
<p local-id=3D"587d2febfc8e">Duplicate records may be created</p></td>
<td data-local-id=3D"7a910aed-c223-48a6-9e61-b16012a594db" class=3D"conflue=
nceTd">
<p local-id=3D"b05a21e8ec5f">Staff and volunteers carry additional workload=
</p></td>
<td data-local-id=3D"ed1217fb-b245-4aaf-8d42-4b6c689d0cf6" class=3D"conflue=
nceTd">
<p local-id=3D"a642cf8929c8">Increased possibility of human error</p></td>
<td data-local-id=3D"b795dd6d-407e-46bc-9f6b-65734518169b" class=3D"conflue=
nceTd">
<p local-id=3D"c69402a83b58">High</p></td>
</tr>
<tr data-local-id=3D"f747bc11-262a-41b4-8e72-fcaadb73773c">
<td data-local-id=3D"02e88e53-68e9-4c37-a892-4d93736a4623" class=3D"conflue=
nceTd">
<p local-id=3D"5c85860b2511">Inconsistent records</p></td>
<td data-local-id=3D"167fd09b-2752-408d-8a7d-c3a8d7109e01" class=3D"conflue=
nceTd">
<p local-id=3D"6dcbb9a1eec0">Staff must verify information</p></td>
<td data-local-id=3D"b08f4383-b2ec-4b65-86fb-07cd8af0f85e" class=3D"conflue=
nceTd">
<p local-id=3D"24e1a6b48b88">Records may be outdated or conflicting</p></td=
>
<td data-local-id=3D"154e0eed-caf8-4a20-9de9-4307957fbf64" class=3D"conflue=
nceTd">
<p local-id=3D"eee0e28882b0">Clubs and staff may receive different informat=
ion</p></td>
<td data-local-id=3D"35b11536-0943-46f0-a44c-3c46e933e133" class=3D"conflue=
nceTd">
<p local-id=3D"853da7d2ba98">Reduced information reliability</p></td>
<td data-local-id=3D"484af1fd-a96d-4e5f-8a7e-16eaaaba54f9" class=3D"conflue=
nceTd">
<p local-id=3D"7da2f34a543c">High</p></td>
</tr>
<tr data-local-id=3D"6d053eeb-8cec-4fe4-ae28-aac6d22a90e4">
<td data-local-id=3D"ba0c3ee7-c9d4-467d-8807-e29a910bff96" class=3D"conflue=
nceTd">
<p local-id=3D"3dfaa3448377">Slow reporting</p></td>
<td data-local-id=3D"dbb5f0f5-ef84-4362-91a4-45d2bebdf335" class=3D"conflue=
nceTd">
<p local-id=3D"e3045fd67219">Reports take longer to prepare</p></td>
<td data-local-id=3D"5e61479a-1568-4e0a-86b0-492975e1478c" class=3D"conflue=
nceTd">
<p local-id=3D"b433ce41a047">Information must be manually consolidated</p><=
/td>
<td data-local-id=3D"2d878d79-fcfa-468c-a18e-87951f9a5432" class=3D"conflue=
nceTd">
<p local-id=3D"407e5fb3692e">Management receives information more slowly</p=
></td>
<td data-local-id=3D"a4c7dc63-a425-404a-8e85-8281535ff953" class=3D"conflue=
nceTd">
<p local-id=3D"2ad3ab992b5e">Decisions may be delayed</p></td>
<td data-local-id=3D"160ed296-856f-499f-9f63-c3fc7a267808" class=3D"conflue=
nceTd">
<p local-id=3D"2c4677f81a56">High</p></td>
</tr>
<tr data-local-id=3D"a83b12c6-5ff9-4bbc-96b0-098ddd33407e">
<td data-local-id=3D"cf756f59-89d9-4f4e-b794-743552b3b0d4" class=3D"conflue=
nceTd">
<p local-id=3D"5961953b5d3f">Limited operational visibility</p></td>
<td data-local-id=3D"ab4d5a64-e2df-45db-ad22-c35cfb7227c4" class=3D"conflue=
nceTd">
<p local-id=3D"50195a8b14e7">Activities are difficult to monitor collective=
ly</p></td>
<td data-local-id=3D"7a544c7b-5615-4262-96d0-d40a24da82db" class=3D"conflue=
nceTd">
<p local-id=3D"0b30e2789025">No consolidated operational view</p></td>
<td data-local-id=3D"24e8846f-6a19-4bdf-85b8-229c6e5ff363" class=3D"conflue=
nceTd">
<p local-id=3D"fdaeb31e0c37">Management and Board have reduced visibility</=
p></td>
<td data-local-id=3D"3005cad7-4000-4230-b0dc-7cf438afaf32" class=3D"conflue=
nceTd">
<p local-id=3D"0d0fbf05751a">Oversight becomes more difficult</p></td>
<td data-local-id=3D"4bb31d05-ba5e-4423-af37-ffe091289bb5" class=3D"conflue=
nceTd">
<p local-id=3D"93882046aa06">High</p></td>
</tr>
<tr data-local-id=3D"829ad362-cfb1-4aaf-9549-a50d88050c78">
<td data-local-id=3D"1fa4173e-0a6c-4129-b944-82229a235146" class=3D"conflue=
nceTd">
<p local-id=3D"317f0955278e">Disconnected tools</p></td>
<td data-local-id=3D"3ae79372-b40d-4a30-a9d8-465a965ce0d7" class=3D"conflue=
nceTd">
<p local-id=3D"6525d9f7568a">Systems and processes do not work together eff=
iciently</p></td>
<td data-local-id=3D"39c2b979-06b8-4003-bec3-726a4fd7f49d" class=3D"conflue=
nceTd">
<p local-id=3D"05a3280eabea">Information remains distributed</p></td>
<td data-local-id=3D"52b6ea7c-fe19-4997-935b-9ae66bb2f68e" class=3D"conflue=
nceTd">
<p local-id=3D"7badfc0ab43b">Staff must use multiple tools</p></td>
<td data-local-id=3D"cf1286e8-34e2-4559-938a-694424e252b3" class=3D"conflue=
nceTd">
<p local-id=3D"276b9eb223e3">Integration and access risks increase</p></td>
<td data-local-id=3D"0fc03268-fecc-474f-992f-5c7702b02c8f" class=3D"conflue=
nceTd">
<p local-id=3D"6473cffeae1b">Medium to High</p></td>
</tr>
</tbody>
</table>
</div>
<p local-id=3D"8888ee54898a">The most significant business impacts are incr=
eased administrative effort, reduced information reliability, slow reportin=
g, limited management visibility and greater information-governance difficu=
lty. These impacts affect ActiveWest=E2=80=99s ability to coordinate activi=
ties and make timely, evidence-based decisions.</p>
    </div>
</body>
